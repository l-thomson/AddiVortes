TARGET = @TARGET@
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libthiessen.a
PKG_LIBS = -L$(LIBDIR) -lthiessen -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll
CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/rust/vendor

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB) rust_clean

$(SHLIB): $(STATLIB)

# Rtools ships no libgcc_eh; an empty archive satisfies the link line the
# Rust standard library emits on the gnu targets. Otherwise as Makevars.
$(STATLIB):
	mkdir -p "$(CARGOTMP)/libgcc_mock"
	touch "$(CARGOTMP)/libgcc_mock/libgcc_eh.a"
	if [ ! -d rust/core ] && [ -f rust/vendor.tar.xz ]; then \
	  tar xf rust/vendor.tar.xz -C rust; \
	  touch rust/.unpacked; \
	fi
	if [ -d "$(VENDOR_DIR)" ]; then \
	  cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	  offline="--offline"; \
	else \
	  offline=""; \
	fi; \
	export CARGO_HOME="$(CARGOTMP)" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CARGOTMP)/libgcc_mock" && \
	cargo build --jobs 2 $$offline --target=$(TARGET) --lib --release \
	  --manifest-path=./rust/Cargo.toml --target-dir="$(TARGET_DIR)"
	rm -Rf "$(CARGOTMP)"

rust_clean: $(SHLIB)
	rm -Rf "$(CARGOTMP)" "$(TARGET_DIR)"
	if [ -f rust/.unpacked ]; then \
	  rm -Rf "$(VENDOR_DIR)" rust/core rust/.unpacked; \
	fi

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" "$(CARGOTMP)"
