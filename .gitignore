# Cargo build output at any depth.
target/

# Python package working state
/python/.venv*
/python/dist
/python/site
/python/.coverage
/python/coverage.xml
/python/python/thiessen/*.so
__pycache__/
*.egg-info/

# R package working state
/r/src/*.o
/r/src/*.so
/r/src/*.dll
# Ignored so that a scan of the tree finds the crate name `thiessen` once;
# the core is tracked all the same, and the r-source job stages it by force
# to compare it against the workspace core.
/r/src/rust/core
/r/src/rust/vendor
/r/src/rust/vendor.tar.xz
/r/src/.cargo
/r/src/rust/.unpacked
/r/src/Makevars.win
/r/docs

# R build and check output, wherever the command is run from
*.Rcheck/
/*.tar.gz

# Publisher PDFs; never tracked.
/maths
