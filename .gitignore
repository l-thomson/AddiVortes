# Cargo build output at any depth.
target/

# Python package working state
/python/.venv*
/python/dist
/python/site
/python/.coverage
/python/coverage.xml
/python/python/thiessen/*.so
__pycache__/
*.egg-info/

# R package working state
/r/src/*.o
/r/src/*.so
/r/src/*.dll
/r/src/rust/vendor
/r/src/rust/vendor.tar.xz
/r/src/.cargo
/r/src/rust/.unpacked
/r/src/Makevars.win
/r/docs

# R build and check output, wherever the command is run from
*.Rcheck/
/*.tar.gz

# Publisher PDFs; never tracked.
/maths
